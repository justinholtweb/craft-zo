<hr>
<h2>{{ 'Preview'|t('zo') }}</h2>

<div class="pane">
    <p>{{ 'The exact JSON your most recent completed order would be sent as, built by the same code the sync uses.'|t('zo') }}</p>
    <p>
        <button type="button" class="btn" id="zo-preview">{{ 'Preview payload'|t('zo') }}</button>
        <span id="zo-preview-note" class="light"></span>
    </p>
    <pre id="zo-preview-out" class="code" style="display:none; max-height: 340px; overflow: auto; background: #f7f8f9; padding: 10px; border-radius: 4px;"></pre>
</div>

{% js %}
(function() {
    function note(id, message, isError) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = message;
        el.className = isError ? 'error' : 'light';
    }

    function bind(id, method, action, handler) {
        var button = document.getElementById(id);
        if (!button) return;
        button.addEventListener('click', function() {
            note(id + '-note', '…', false);
            Craft.sendActionRequest(method, action)
                .then(function(response) { handler(response.data); })
                .catch(function(e) {
                    var data = (e.response && e.response.data) || {};
                    note(id + '-note', data.message || {{ 'That didn’t work.'|t('zo')|json_encode|raw }}, true);
                });
        });
    }

    bind('zo-test', 'POST', 'zo/settings/test-connection', function(data) {
        note('zo-test-note', data.message, !data.success);
    });

    bind('zo-orgs', 'GET', 'zo/settings/organizations', function(data) {
        if (!data.success) { note('zo-orgs-note', data.message, true); return; }
        var parts = (data.organizations || []).map(function(o) { return o.id + ' — ' + o.name; });
        note('zo-orgs-note', parts.join(' · ') || {{ 'No organizations found.'|t('zo')|json_encode|raw }}, false);
    });

    bind('zo-taxes', 'GET', 'zo/settings/taxes', function(data) {
        if (!data.success) { note('zo-taxes-note', data.message, true); return; }
        var parts = (data.taxes || []).map(function(t) { return t.id + ' — ' + t.name + ' (' + t.percentage + '%)'; });
        note('zo-taxes-note', parts.join(' · ') || {{ 'No tax rates found.'|t('zo')|json_encode|raw }}, false);
    });

    bind('zo-accounts', 'GET', 'zo/settings/accounts', function(data) {
        if (!data.success) { note('zo-accounts-note', data.message, true); return; }
        var parts = (data.accounts || []).map(function(a) { return a.id + ' — ' + a.name; });
        note('zo-accounts-note', parts.join(' · ') || {{ 'No accounts found.'|t('zo')|json_encode|raw }}, false);
    });

    bind('zo-preview', 'GET', 'zo/settings/preview', function(data) {
        var out = document.getElementById('zo-preview-out');
        if (!data.success) { note('zo-preview-note', data.message, true); return; }
        out.style.display = 'block';
        out.textContent = data.payload;
        note(
            'zo-preview-note',
            data.orderNumber + ' · ' +
            (data.matches
                ? {{ 'totals match'|t('zo')|json_encode|raw }}
                : {{ 'Zoho would total this differently'|t('zo')|json_encode|raw }}),
            !data.matches
        );
    });

    var disconnect = document.getElementById('zo-disconnect');
    if (disconnect) {
        disconnect.addEventListener('click', function() {
            Craft.sendActionRequest('POST', 'zo/settings/disconnect')
                .then(function() { window.location.reload(); })
                .catch(function() { note('zo-test-note', {{ 'Couldn’t disconnect.'|t('zo')|json_encode|raw }}, true); });
        });
    }
})();
{% endjs %}
