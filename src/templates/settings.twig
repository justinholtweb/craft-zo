<hr>
<h2>{{ 'Tax'|t('zo') }}</h2>

<div class="pane">
    <p>
        {{ 'Commerce and Zoho Books both know how to calculate tax, and they will not always agree. Whichever you choose, Zo compares the total Zoho returns against the total the customer actually paid and flags any difference.'|t('zo') }}
    </p>
</div>

{{ forms.selectField({
    label: 'Tax handling'|t('zo'),
    id: 'taxMode',
    name: 'taxMode',
    value: settings.taxMode,
    options: [
        { label: 'Commerce is the source of truth (recommended)'|t('zo'), value: 'adjustment' },
        { label: 'Let Zoho calculate from mapped rates (Pro)'|t('zo'), value: 'mapped' },
        { label: 'No tax'|t('zo'), value: 'none' }
    ],
    instructions: 'The first sends the tax Commerce charged as an adjustment, so the invoice total matches the payment to the cent. The second gives Zoho proper tax records but lets the two totals drift.'|t('zo')
}) }}

{{ forms.textField({
    label: 'Adjustment description'|t('zo'),
    instructions: 'What the adjustment line is called on the invoice.'|t('zo'),
    id: 'adjustmentDescription',
    name: 'adjustmentDescription',
    value: settings.adjustmentDescription
}) }}

{{ forms.editableTableField({
    label: 'Tax mapping (Pro)'|t('zo'),
    instructions: 'Commerce tax category → Zoho tax ID. Only used in “let Zoho calculate” mode.'|t('zo'),
    id: 'taxMap',
    name: 'taxMap',
    cols: {
        category: { heading: 'Tax category'|t('zo'), type: 'select', options: taxCategoryOptions },
        taxId: { heading: 'Zoho tax ID'|t('zo'), type: 'singleline', code: true }
    },
    rows: taxMapRows,
    addRowLabel: 'Add a mapping'|t('zo'),
    allowAdd: true,
    allowDelete: true,
    allowReorder: false
}) }}

<p>
    <button type="button" class="btn small" id="zo-taxes">{{ 'Look up Zoho tax IDs'|t('zo') }}</button>
    <span id="zo-taxes-note" class="light"></span>
</p>

{{ forms.textField({
    label: 'Variance tolerance'|t('zo'),
