{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks perfect, Craft reports “Plugin settings saved”, and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

{% set connected = settings.getIsConnected() %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Zo needs it to do anything.'|t('zo') }}</p>
    </div>
{% endif %}

{# ------------------------------------------------------------------ #}
<h2>{{ 'Connection'|t('zo') }}</h2>

<div class="pane">
    {% if connected %}
        <p>
            <span class="checkbox-icon" data-icon="check"></span>
            <strong>{{ 'Zo is connected to Zoho Books.'|t('zo') }}</strong>
        </p>
        <p>
            <button type="button" class="btn" id="zo-test">{{ 'Test connection'|t('zo') }}</button>
            <span id="zo-test-note" class="light"></span>
        </p>
        <p>
            <a class="btn" href="{{ actionUrl('zo/settings/connect') }}">{{ 'Reconnect'|t('zo') }}</a>
            <button type="button" class="btn" id="zo-disconnect">{{ 'Disconnect'|t('zo') }}</button>
        </p>
    {% else %}
        <p>{{ 'Create a Server-based Application in the Zoho API console, then paste its client ID and secret below and connect.'|t('zo') }}</p>
        <p>
            <a class="btn submit{{ settings.getCanConnect() ? '' : ' disabled' }}"
               href="{{ settings.getCanConnect() ? actionUrl('zo/settings/connect') : '#' }}">
                {{ 'Connect to Zoho Books'|t('zo') }}
            </a>
            {% if not settings.getCanConnect() %}
                <span class="light">{{ 'Save a client ID and secret first.'|t('zo') }}</span>
            {% endif %}
        </p>
    {% endif %}

    {{ forms.textField({
        label: 'Authorized Redirect URI'|t('zo'),
        instructions: 'Register this in the Zoho API console, exactly as shown. Zoho matches it character for character.'|t('zo'),
        id: 'zo-redirect',
        value: settings.getRedirectUri(),
        readonly: true,
        class: 'code'
    }) }}

    {% if not settings.getRedirectUriIsClean() %}
        <p class="warning">
            {{ 'This URL contains a query string because the site has neither `omitScriptNameInUrls` nor `usePathInfo` enabled. Zoho’s redirect URIs are ordinarily bare paths — turn one of those settings on before registering it.'|t('zo') }}
        </p>
    {% endif %}
</div>

{{ forms.selectField({
    label: 'Data centre'|t('zo'),
    instructions: 'The region your Zoho account lives in. Zoho’s regions do not share data, and a token from one is rejected by another — usually as a bare 401 that looks like bad credentials.'|t('zo'),
    id: 'dataCenter',
    name: 'dataCenter',
    value: settings.dataCenter,
    options: dataCenterOptions
}) }}

{{ forms.autosuggestField({
    label: 'Client ID'|t('zo'),
    instructions: 'From the Zoho API console.'|t('zo'),
    id: 'clientId',
    name: 'clientId',
    value: settings.clientId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: 'Client secret'|t('zo'),
    id: 'clientSecret',
    name: 'clientSecret',
    value: settings.clientSecret,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: 'Refresh token'|t('zo'),
    instructions: 'Filled in for you when you connect. **Move it to an environment variable** — plugin settings are stored in project config, and project config gets committed.'|t('zo'),
    id: 'refreshToken',
    name: 'refreshToken',
    value: settings.refreshToken,
    suggestEnvVars: true
}) }}

{% if settings.refreshToken and settings.refreshToken[0:1] != '$' %}
    <p class="warning" style="margin-top: -14px;">
        {{ 'This refresh token is stored in project config in plain text. Anyone with repository access can use it to read and write your books.'|t('zo') }}
    </p>
{% endif %}

<div class="field">
    {{ forms.autosuggest({
        id: 'organizationId',
        name: 'organizationId',
        value: settings.organizationId,
        suggestEnvVars: true
    }) }}
    <div class="heading" style="margin-top: 4px;">
        <button type="button" class="btn small" id="zo-orgs">{{ 'Look up organizations'|t('zo') }}</button>
        <span id="zo-orgs-note" class="light"></span>
    </div>
</div>
<div class="field" style="margin-top: -18px;">
    <div class="instructions"><p>{{ 'Organization ID — every Zoho Books call is scoped to one organization. Get it wrong on a multi-entity account and the invoices file against the wrong company.'|t('zo') }}</p></div>
</div>

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'What gets synced'|t('zo') }}</h2>

{{ forms.lightswitchField({
    label: 'Sync when an order is completed'|t('zo'),
    instructions: 'The usual choice. Work is handed to the queue, so checkout is never waiting on Zoho.'|t('zo'),
    id: 'autoSyncOnComplete',
    name: 'autoSyncOnComplete',
    on: settings.autoSyncOnComplete
}) }}

{{ forms.lightswitchField({
    label: 'Sync when an order is fully paid'|t('zo'),
    instructions: 'For stores that invoice on payment rather than on order.'|t('zo'),
    id: 'autoSyncOnPaid',
    name: 'autoSyncOnPaid',
    on: settings.autoSyncOnPaid
}) }}

{{ forms.checkboxSelectField({
    label: 'Also sync when an order reaches these statuses'|t('zo'),
    id: 'syncOnStatusHandles',
    name: 'syncOnStatusHandles',
    options: statusOptions,
    values: settings.syncOnStatusHandles
}) }}

{{ forms.checkboxSelectField({
    label: 'Only sync orders in these statuses'|t('zo'),
    instructions: 'Leave everything unchecked to sync every completed order.'|t('zo'),
    id: 'eligibleStatusHandles',
    name: 'eligibleStatusHandles',
    options: statusOptions,
    values: settings.eligibleStatusHandles
}) }}

{{ forms.textField({
    label: 'Minimum order total'|t('zo'),
    instructions: 'Orders below this are skipped. Useful for comped and zero-value orders.'|t('zo'),
    id: 'minimumOrderTotal',
    name: 'minimumOrderTotal',
    value: settings.minimumOrderTotal,
    size: 8
}) }}

{{ forms.lightswitchField({
    label: 'Sync through the queue'|t('zo'),
    instructions: 'Leave this on. Turning it off makes Zoho’s response time part of your checkout’s.'|t('zo'),
    id: 'syncViaQueue',
    name: 'syncViaQueue',
    on: settings.syncViaQueue
}) }}

{{ forms.textField({
    label: 'Maximum attempts'|t('zo'),
    instructions: 'How many times a failing order is retried before it stops being retried automatically.'|t('zo'),
    id: 'maxAttempts',
    name: 'maxAttempts',
    value: settings.maxAttempts,
    size: 4
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Documents'|t('zo') }}</h2>

