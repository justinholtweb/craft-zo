    options: [
        { label: 'Let Zoho Books number it'|t('zo'), value: 'zoho' },
        { label: 'Order reference'|t('zo'), value: 'reference' },
        { label: 'Order number'|t('zo'), value: 'number' },
        { label: 'Short order number'|t('zo'), value: 'shortNumber' }
    ]
}) }}

{{ forms.selectField({
    label: 'Reference number'|t('zo'),
    instructions: 'What lands in Zoho’s own reference field.'|t('zo'),
    id: 'referenceSource',
    name: 'referenceSource',
    value: settings.referenceSource,
    options: [
        { label: 'Order reference'|t('zo'), value: 'reference' },
        { label: 'Order number'|t('zo'), value: 'number' },
        { label: 'Short order number'|t('zo'), value: 'shortNumber' },
        { label: 'Order ID'|t('zo'), value: 'id' }
